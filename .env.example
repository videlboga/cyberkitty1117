# .env.example — copy to .env and fill in real values.
# .env is NOT committed (see .gitignore); this file only holds examples/defaults.

# --- Telegram bot ---
# Bot token from @BotFather. CYBERKITTY_TG_BOT_TOKEN is an alternative name.
TG_BOT_TOKEN=
CYBERKITTY_TG_BOT_TOKEN=

# --- LLM / OpenRouter ---
# An OpenRouter key starts with sk-or- and is automatically routed to
# https://openrouter.ai/api/v1 (see modules/config.py). A regular OpenAI key
# (sk-...) uses the default OpenAI endpoint.
OPENAI_API_KEY=

# Text model identifier on OpenRouter. deepseek/deepseek-v4-flash is the fast,
# cheap default used in modules/llm_client.py.
TEXT_MODEL=deepseek/deepseek-v4-flash

# Generation params (optional, passed to chat.completions.create only if set).
MAX_TOKENS=
TEMPERATURE=

# --- Proxy (optional) ---
# PROXY_YES=true|false toggles the proxy for the httpx/openai client.
PROXY_YES=
PROXY_HTTP=
PROXY_HTTPS=

# --- Database ---
# DATABASE_URL — path/URL to the JSON DB (CYBERKITTY_DATABASE_URL is an alias).
DATABASE_URL=
# CYBERKITTY_DATABASE_URL=

# --- Config file (optional) ---
# Path to config.cfg; defaults to ./config.cfg.
# CONFIG_FILE=./config.cfg

# --- Userbot (pyrogram, modules/userbot_sync.py) ---
# API credentials from https://my.telegram.org. Only needed for userbot sync.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
SESSION_NAME=userbot_session
# SOCKS5 for MTProto when direct access is blocked by DPI.
SOCKS5_PROXY=socks5://127.0.0.1:1080

# --- Google Sheets (optional, modules/gsheets.py) ---
# Path to the service account JSON. The file MUST live OUTSIDE the repo.
# GOOGLE_APPLICATION_CREDENTIALS=/home/you/keys/service-account.json
